{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the main local window can access bounded reader and library commands. No filesystem or dialog plugin commands exposed.",
  "windows": ["main"],
  "permissions": [
    "allow-list-books",
    "allow-begin-open",
    "allow-open-selected",
    "allow-cancel-open",
    "allow-close-book",
    "allow-request-page",
    "allow-release-page",
    "allow-add-books",
    "allow-remove-book",
    "allow-open-library-book",
    "allow-record-progress",
    "allow-flush-progress",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy"
  ]
}
